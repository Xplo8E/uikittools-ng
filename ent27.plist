<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
	<key>platform-application</key><true/>

	<!-- The lsd embedded-registration gate accepts any one of these. All three are retained
	     because the deployed, measured-good binary carried the same set. -->
	<key>com.apple.private.coreservices.lsaw</key><true/>
	<key>com.apple.private.installcoordinationd.daemon</key><true/>
	<key>com.apple.private.coreservices.can-register-install-results</key><true/>

	<!-- Required by the complete registration dictionary and its container/install path. -->
	<key>com.apple.private.MobileContainerManager.allowed</key><true/>
	<key>com.apple.private.coreservices.installcoordinationd</key><true/>
	<key>com.apple.private.MobileInstallationHelperService.allowed</key><true/>
	<key>com.apple.private.mobileinstall.allowedSPI</key>
	<array><string>InstallForLaunchServices</string><string>UninstallForLaunchServices</string></array>

	<!-- Bundle traversal and the existing rebuild operation. -->
	<key>com.apple.private.security.no-sandbox</key><true/>
	<key>com.apple.private.security.container-required</key><false/>
	<key>com.apple.private.security.storage.AppBundles</key><true/>
	<key>com.apple.private.security.storage.containers</key><true/>
	<key>com.apple.lsapplicationworkspace.rebuildappdatabases</key><true/>
</dict></plist>
